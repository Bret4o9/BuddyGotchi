<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:gravity="center_vertical">

    <!-- LEFT COLUMN: BUDDY COMPANION -->
    <LinearLayout
        android:id="@+id/widget_buddy_container"
        android:layout_width="116dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">

        <!-- Animated Eye Flipper (Smooth 140ms frames with easing transitions) -->
        <ViewFlipper
            android:id="@+id/widget_buddy_eyes_flipper"
            android:layout_width="96dp"
            android:layout_height="46dp"
            android:autoStart="true"
            android:flipInterval="140">

            <!-- 1. Center resting (14 frames = ~1.96s) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />

            <!-- 2. Smooth Blink 1 (4 frames = ~560ms) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_quarter" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_closed" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_half" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_quarter" />

            <!-- 3. Center resting (9 frames = ~1.26s) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />

            <!-- 4. Glance Right at Task (10 frames = ~1.40s with ease-in and ease-out) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right_soft" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_right_soft" />

            <!-- 5. Center resting (8 frames = ~1.12s) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />

            <!-- 6. Playful Double Blink (6 frames = ~840ms) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_half" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_closed" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_quarter" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_closed" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_half" />

            <!-- 7. Glance Left (8 frames = ~1.12s with ease-in and ease-out) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_left_soft" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_left" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_left" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_left" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_left" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_left" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_look_left_soft" />

            <!-- 8. Center resting (6 frames = ~840ms) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />

            <!-- 9. Happy Expression (10 frames = ~1.40s) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_quarter" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_half" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_happy" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_happy" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_happy" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_happy" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_happy" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_happy" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_half" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_blink_quarter" />

            <!-- 10. Center resting before repeating loop (10 frames = ~1.40s) -->
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/buddy_eyes_center" />

        </ViewFlipper>


        <!-- Level Text -->
        <TextView
            android:id="@+id/widget_buddy_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="LVL 1 BUDDY"
            android:textColor="@color/nothing_red"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <!-- XP Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_buddy_xp_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="66dp"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="50"
            android:progress="20"
            android:progressDrawable="@drawable/widget_progress_track" />

        <!-- XP Text -->
        <TextView
            android:id="@+id/widget_buddy_xp_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="20 / 50 XP"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8.5sp" />

    </LinearLayout>

    <!-- VERTICAL DIVIDER -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp"
        android:background="@color/widget_stroke" />

    <!-- RIGHT COLUMN: NEXT TASK -->
    <LinearLayout
        android:id="@+id/widget_task_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_task_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Header: Next Task Label + Category Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_task_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEXT TASK"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_task_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORK"
                android:textColor="@color/nothing_red"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:background="@drawable/widget_category_pill"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <!-- Time & Countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/widget_task_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textColor="@color/white"
                android:textSize="18.5sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/widget_task_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="in 45m"
                android:textColor="@color/nothing_red"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Task / Event Title -->
        <TextView
            android:id="@+id/widget_task_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Sprint review &amp; presentation"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Footer Call-to-Action -->
        <TextView
            android:id="@+id/widget_task_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Tap to open in BuddyGotchi →"
            android:textColor="@color/widget_text_muted"
            android:textSize="8sp" />

    </LinearLayout>

</LinearLayout>
